{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "formulae.yaml",
  "description": "Registry of generated Homebrew formulae, keyed by formula name.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source", "desc", "homepage", "platforms", "install", "test"],
    "properties": {
      "source": {
        "enum": ["github", "go"],
        "description": "Where releases come from: `github` reads GitHub releases, `go` reads go.dev."
      },
      "repo": {
        "type": "string",
        "description": "GitHub repository (owner/name) whose latest release provides the version and sha256.",
        "pattern": "^[^/]+/[^/]+$"
      },
      "desc": {
        "type": "string",
        "description": "Formula description.",
        "minLength": 1
      },
      "homepage": {
        "type": "string",
        "description": "Formula homepage.",
        "minLength": 1
      },
      "release_notes": {
        "type": "string",
        "description": "Release notes link for the PR body; `#{version}` is replaced by the version. Defaults to the GitHub release; required for `source: go`.",
        "pattern": "#\\{version\\}"
      },
      "conflicts": {
        "type": "array",
        "description": "Formulae to emit as `conflicts_with`.",
        "items": {
          "type": "string"
        }
      },
      "platforms": {
        "type": "object",
        "description": "Supported platforms, each mapped to its release asset name (`#{version}` is replaced by the version). A platform is supported only if listed. The formula gets `depends_on :macos` or `:linux` when an OS is absent, and an `on_macos`/`on_linux` arch constraint when only one of its arches is listed.",
        "minProperties": 1,
        "propertyNames": {
          "enum": ["darwin-arm64", "darwin-amd64", "linux-amd64", "linux-arm64"]
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[^/]+$"
        }
      },
      "install": {
        "type": "array",
        "description": "Ruby lines for the `install` block.",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "test": {
        "type": "string",
        "description": "Ruby body of the `test do` block.",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "source": {
              "const": "go"
            }
          },
          "required": ["source"]
        },
        "then": {
          "required": ["release_notes"],
          "properties": {
            "repo": false,
            "conflicts": false
          }
        },
        "else": {
          "required": ["repo"]
        }
      }
    ]
  },
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
  }
}
