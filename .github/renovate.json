{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigestsToSemver"],
  "enabledManagers": ["custom.regex", "github-actions", "gomod"],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-tags",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?<depName>Homebrew/actions)/[\\w-]+@(?<currentDigest>[a-f0-9]{40}) # (?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["Homebrew/actions"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ],
  "platformAutomerge": false,
  "postUpdateOptions": ["gomodTidy"]
}
